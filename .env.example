# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URL ──────────────────────────────────────────────────────────────────
# Production: set to your actual domain (e.g. https://selftrace.vercel.app)
# This is used for OAuth callback URLs and redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── X (Twitter) OAuth 2.0 ───────────────────────────────────────────────────
# Create an app at https://developer.x.com/en/portal/dashboard
# Enable OAuth 2.0 with PKCE (public client)
#
# Required callback URLs to register in the X Developer Portal:
#   - Local:      http://localhost:3000/api/oauth/x/callback
#   - Production: https://selftrace.vercel.app/api/oauth/x/callback
#
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret

# ── Future Platforms (not yet implemented) ───────────────────────────────────
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
